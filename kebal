-- BALEREOT | GAME COMBAT (server)
-- Taruh sebagai *Script* di ServerScriptService.
--
-- Isi:
--  1) Musuh: Model berisi Humanoid + HumanoidRootPart yang bernama "Enemy"
--     (atau diberi tag "Enemy") otomatis mengejar pemain terdekat dan menyerang.
--  2) Senjata: Tool dengan part "Handle". Atur damage dasar lewat Attribute "Damage" di Tool.
--  3) Semua damage lewat satu fungsi applyDamage -> God Mode benar-benar kebal.
--  4) Damage pemain ke musuh dikali PLAYER_DAMAGE_MULT.
--
-- Script lain di game-mu bisa memberi damage lewat:  _G.BC_Damage(humanoid, jumlah)

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")

local CONFIG = {
    GOD_ALL = true,              -- true = semua pemain kebal
    GOD_USERS = {},              -- kalau GOD_ALL = false, isi nama pemain, contoh {"NamaKamu"}
    PLAYER_DAMAGE_MULT = 5,      -- damage senjata pemain ke musuh dikali ini
    DEFAULT_WEAPON_DAMAGE = 10,  -- damage dasar Tool kalau tidak punya Attribute "Damage"
    SWING_TIME = 0.5,            -- lama ayunan senjata yang bisa mengenai musuh (detik)

    ENEMY_DAMAGE = 20,
    ENEMY_ATTACK_RANGE = 5,
    ENEMY_COOLDOWN = 1,
    ENEMY_SIGHT = 80,
    ENEMY_SPEED = 14,
}

-- =====================================================================
-- DAMAGE (satu pintu)
-- =====================================================================
local function isGod(player)
    return CONFIG.GOD_ALL
        or table.find(CONFIG.GOD_USERS, player.Name) ~= nil
        or player:GetAttribute("God") == true
end

local function applyDamage(humanoid, amount, source)
    if not humanoid or humanoid.Health <= 0 or amount <= 0 then return end
    local model = humanoid.Parent
    local player = model and Players:GetPlayerFromCharacter(model)
    if player and isGod(player) then return end   -- kebal total
    humanoid.Health = math.max(0, humanoid.Health - amount)
end
_G.BC_Damage = applyDamage

-- =====================================================================
-- MUSUH
-- =====================================================================
local function isEnemy(m)
    return m:IsA("Model") and (m.Name == "Enemy" or CollectionService:HasTag(m, "Enemy"))
end

local function runEnemy(model)
    local hum = model:WaitForChild("Humanoid", 5)
    local root = model:WaitForChild("HumanoidRootPart", 5)
    if not hum or not root then return end
    hum.WalkSpeed = CONFIG.ENEMY_SPEED
    local lastAttack = 0

    while model.Parent and hum.Health > 0 do
        local target, bestDist = nil, CONFIG.ENEMY_SIGHT
        for _, p in ipairs(Players:GetPlayers()) do
            local c = p.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = (r.Position - root.Position).Magnitude
                if d < bestDist then target, bestDist = h, d end
            end
        end

        if target then
            if bestDist <= CONFIG.ENEMY_ATTACK_RANGE then
                if os.clock() - lastAttack >= CONFIG.ENEMY_COOLDOWN then
                    lastAttack = os.clock()
                    applyDamage(target, CONFIG.ENEMY_DAMAGE, model)
                end
            else
                local tr = target.Parent:FindFirstChild("HumanoidRootPart")
                if tr then hum:MoveTo(tr.Position) end
            end
        end
        task.wait(0.2)
    end
end

local running = setmetatable({}, {__mode = "k"})
local function tryStart(m)
    if running[m] or not isEnemy(m) then return end
    running[m] = true
    task.spawn(runEnemy, m)
end
for _, d in ipairs(workspace:GetDescendants()) do
    if d:IsA("Model") then tryStart(d) end
end
workspace.DescendantAdded:Connect(function(d)
    if d:IsA("Model") then task.defer(tryStart, d) end
end)
CollectionService:GetInstanceAddedSignal("Enemy"):Connect(tryStart)

-- =====================================================================
-- SENJATA PEMAIN
-- =====================================================================
local function hookTool(tool, player)
    if tool:GetAttribute("BCHooked") then return end
    local handle = tool:FindFirstChild("Handle")
    if not handle then return end
    tool:SetAttribute("BCHooked", true)

    local swinging, hit = false, {}
    tool.Activated:Connect(function()
        swinging, hit = true, {}
        task.delay(CONFIG.SWING_TIME, function() swinging = false end)
    end)
    handle.Touched:Connect(function(other)
        if not swinging then return end
        local model = other:FindFirstAncestorOfClass("Model")
        local h = model and model:FindFirstChildOfClass("Humanoid")
        if not h or hit[h] then return end
        if model == player.Character or Players:GetPlayerFromCharacter(model) then return end
        hit[h] = true
        local base = tool:GetAttribute("Damage") or CONFIG.DEFAULT_WEAPON_DAMAGE
        applyDamage(h, base * CONFIG.PLAYER_DAMAGE_MULT, player)
    end)
end

local function hookContainer(container, player)
    for _, t in ipairs(container:GetChildren()) do
        if t:IsA("Tool") then hookTool(t, player) end
    end
    container.ChildAdded:Connect(function(t)
        if t:IsA("Tool") then hookTool(t, player) end
    end)
end

local function setupPlayer(player)
    player.CharacterAdded:Connect(function(c) hookContainer(c, player) end)
    if player.Character then hookContainer(player.Character, player) end

    player.ChildAdded:Connect(function(o)
        if o:IsA("Backpack") then hookContainer(o, player) end
    end)
    local bp = player:FindFirstChildOfClass("Backpack")
    if bp then hookContainer(bp, player) end
end
Players.PlayerAdded:Connect(setupPlayer)
for _, p in ipairs(Players:GetPlayers()) do setupPlayer(p) end

-- drag panel lewat title
do
    local dragging, dragStart, startPos
    connect(title.InputBegan, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPos = true, i.Position, main.Position
        end
    end)
    connect(UIS.InputChanged, function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    connect(UIS.InputEnded, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
end

local y = 42
local function toggleRow(label, key, onChange)
    local row = new("Frame", {Size = UDim2.new(1, -16, 0, 32), Position = UDim2.fromOffset(8, y), BackgroundColor3 = C.input, BorderSizePixel = 0}, main)
    round(row, 8)
    new("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1, Text = label,
        TextColor3 = C.text, Font = Enum.Font.GothamBold, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local btn = new("TextButton", {
        Size = UDim2.fromOffset(52, 22), Position = UDim2.new(1, -60, 0.5, -11), BackgroundColor3 = C.bg,
        Text = "OFF", TextColor3 = C.sub, Font = Enum.Font.GothamBold, TextSize = 10, BorderSizePixel = 0, AutoButtonColor = false,
    }, row)
    round(btn, 11)
    local function paint()
        local on = S[key]
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = on and C.accent or C.bg}):Play()
        btn.Text = on and "ON" or "OFF"
        btn.TextColor3 = on and C.ink or C.sub
    end
    btn.MouseButton1Click:Connect(function()
        S[key] = not S[key]
        paint()
        if onChange then onChange(S[key]) end
    end)
    y += 38
end

local function speedRow(label, key, minV, maxV, step, onChange)
    local row = new("Frame", {Size = UDim2.new(1, -16, 0, 32), Position = UDim2.fromOffset(8, y), BackgroundColor3 = C.input, BorderSizePixel = 0}, main)
    round(row, 8)
    new("TextLabel", {
        Size = UDim2.new(0, 70, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1, Text = label,
        TextColor3 = C.sub, Font = Enum.Font.GothamBold, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local function mkBtn(txt, x)
        local b = new("TextButton", {
            Size = UDim2.fromOffset(26, 22), Position = UDim2.new(1, x, 0.5, -11), BackgroundColor3 = C.accent,
            Text = txt, TextColor3 = C.ink, Font = Enum.Font.GothamBold, TextSize = 14, BorderSizePixel = 0,
        }, row)
        round(b, 6)
        return b
    end
    local minus, plus = mkBtn("-", -122), mkBtn("+", -34)
    local box = new("TextBox", {
        Size = UDim2.fromOffset(52, 22), Position = UDim2.new(1, -92, 0.5, -11), BackgroundColor3 = C.bg,
        Text = tostring(S[key]), TextColor3 = C.text, Font = Enum.Font.Code, TextSize = 11, BorderSizePixel = 0,
        ClearTextOnFocus = false,
    }, row)
    round(box, 6)
    local function setV(v)
        v = math.clamp(math.floor(v + 0.5), minV, maxV)
        S[key] = v
        box.Text = tostring(v)
        if onChange then onChange(v) end
    end
    minus.MouseButton1Click:Connect(function() setV(S[key] - step) end)
    plus.MouseButton1Click:Connect(function() setV(S[key] + step) end)
    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        setV(n or S[key])
    end)
    y += 38
end

toggleRow("GOD MODE (KEBAL)", "god", function(on) if on then godOn() else godOff() end end)
toggleRow("FLY", "fly", function(on) if on then flyOn() else flyOff() end end)
speedRow("Fly speed", "flySpeed", 1, 500, 10)
toggleRow("INFINITE JUMP", "inf")
toggleRow("NOCLIP", "noclip", function(on) if not on then noclipOff() end end)
toggleRow("LARI CEPAT", "sprint", function(on)
    if not on and hum then hum.WalkSpeed = DEFAULT_WALK end
end)
speedRow("Run speed", "runSpeed", 16, 500, 10)

-- Tombol NAIK / TURUN (untuk HP saat fly)
do
    local function holdBtn(txt, x, setter)
        local b = new("TextButton", {
            Size = UDim2.new(0.5, -12, 0, 30), Position = UDim2.new(x, x == 0 and 8 or 4, 0, y), BackgroundColor3 = C.input,
            Text = txt, TextColor3 = C.accent, Font = Enum.Font.GothamBold, TextSize = 11, BorderSizePixel = 0, AutoButtonColor = true,
        }, main)
        round(b, 8)
        new("UIStroke", {Color = C.stroke, Thickness = 1}, b)
        b.MouseButton1Down:Connect(function() setter(true) end)
        b.MouseButton1Up:Connect(function() setter(false) end)
        b.MouseLeave:Connect(function() setter(false) end)
    end
    holdBtn("NAIK ▲", 0, function(v) upHeld = v end)
    holdBtn("TURUN ▼", 0.5, function(v) downHeld = v end)
end


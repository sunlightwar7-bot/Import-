local function addToggle(label, key, onChange)
    local row = addRow(40)
    text3d(row, {Text = label, TextSize = 11, Color = C.text, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -78, 1, 0)})
    local b
    local function paint()
        local on = S[key]
        if on then
            b.setColor(C.accent)
            b.label.set("ON", C.ink, C.accent2)
        else
            b.setColor(C.off)
            b.label.set("OFF", C.sub)
        end
    end
    b = btn3d(row, {
        Size = UDim2.fromOffset(56, 28), Position = UDim2.new(1, -64, 0.5, -14), Color = C.off, Text = "OFF",
        TextColor = C.sub, Radius = 14, TextSize = 10,
        onClick = function()
            S[key] = not S[key]
            paint()
            if onChange then onChange(S[key]) end
        end,
    })
    paint()
end

local function addSpeed(label, key, minV, maxV, step, onChange)
    local row = addRow(40)
    text3d(row, {Text = label, TextSize = 10, Color = C.sub, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(0, 80, 1, 0)})
    local box = new("TextBox", {
        Size = UDim2.fromOffset(52, 24), Position = UDim2.new(1, -92, 0.5, -12), BackgroundColor3 = C.bg,
        Text = tostring(S[key]), TextColor3 = C.text, Font = Enum.Font.Code, TextSize = 12, BorderSizePixel = 0,
        ClearTextOnFocus = false, ZIndex = 4,
    }, row)
    round(box, 6)
    new("UIStroke", {Color = C.stroke, Thickness = 1, Transparency = 0.4}, box)
    local function setV(v)
        v = math.clamp(math.floor(v + 0.5), minV, maxV)
        S[key] = v
        box.Text = tostring(v)
        if onChange then onChange(v) end
    end
    btn3d(row, {
        Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, -124, 0.5, -14), Color = C.accent, Text = "-",
        TextSize = 16, Radius = 7, onClick = function() setV(S[key] - step) end,
    })
    btn3d(row, {
        Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, -36, 0.5, -14), Color = C.accent, Text = "+",
        TextSize = 16, Radius = 7, onClick = function() setV(S[key] + step) end,
    })
    box.FocusLost:Connect(function() setV(tonumber(box.Text) or S[key]) end)
end


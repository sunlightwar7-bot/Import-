}, gui)
round(main, 12)
new("UIStroke", {Color = C.stroke, Thickness = 1.4}, main)

local title = new("Frame", {Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = C.bg, BorderSizePixel = 0}, main)
round(title, 12)
new("Frame", {Size = UDim2.new(1, 0, 0, 10), Position = UDim2.new(0, 0, 1, -10), BackgroundColor3 = C.bg, BorderSizePixel = 0}, title)
new("TextLabel", {
    Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1,

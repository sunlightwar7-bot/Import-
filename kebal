local function connect(sig, fn) local c = sig:Connect(fn); conns[#conns + 1] = c; return c end

-- =====================================================================
-- GOD MODE (kebal beneran)
-- =====================================================================
local healthConn, lastSafe
local function godOn()
    if not hum or not char then return end
    pcall(function()
        hum.BreakJointsOnDeath = false
        hum.RequiresNeck = false
        hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        hum.MaxHealth = math.huge
        hum.Health = math.huge
    end)
    if not char:FindFirstChild("BC_FF") then
        local ff = Instance.new("ForceField")
        ff.Name = "BC_FF"; ff.Visible = false; ff.Parent = char
    end
    if healthConn then healthConn:Disconnect() end
    healthConn = hum.HealthChanged:Connect(function()
        if S.god and hum and hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
    end)
end
local function godOff()
    if healthConn then healthConn:Disconnect(); healthConn = nil end
    if not hum or not char then return end
    local ff = char:FindFirstChild("BC_FF")
    if ff then ff:Destroy() end
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
        hum.RequiresNeck = true
        hum.BreakJointsOnDeath = true
        hum.MaxHealth = 100
        hum.Health = 100
    end)
end

-- =====================================================================
-- FLY
-- =====================================================================
local flyBV, flyBG
local upHeld, downHeld = false, false
local function flyOff()
    if flyBV then flyBV:Destroy(); flyBV = nil end
    if flyBG then flyBG:Destroy(); flyBG = nil end
    if hum then pcall(function() hum.PlatformStand = false end) end
end
local function flyOn()
    flyOff()
    if not root or not hum then return end
    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    flyBV.Velocity = Vector3.zero
    flyBV.Parent = root
    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    flyBG.P = 1e4
    flyBG.CFrame = cam.CFrame
    flyBG.Parent = root
    hum.PlatformStand = true
end

-- =====================================================================
-- NOCLIP
-- =====================================================================
local noclipTouched = {}
local function noclipOff()
    for part in pairs(noclipTouched) do
        if part and part.Parent then pcall(function() part.CanCollide = true end) end
    end
    noclipTouched = {}
end

-- =====================================================================
-- DAMAGE BOOST
--   Tiap kali Tool yang kamu pegang dipakai (Activated), musuh/NPC dalam
--   jangkauan disentuh ulang (dmgMult - 1) kali lewat firetouchinterest,
--   jadi senjata berbasis Touched memberi damage berlipat.
--   Butuh executor dengan firetouchinterest. Tidak berefek kalau damage
--   dihitung server lewat RemoteEvent atau senjata punya debounce.
-- =====================================================================
local hasTouch = typeof(firetouchinterest) == "function"

local function getEnemies()
    local list = {}
    for _, h in ipairs(workspace:GetDescendants()) do
        if h:IsA("Humanoid") and h.Health > 0 and h.Parent and h.Parent ~= char
            and not Players:GetPlayerFromCharacter(h.Parent) then
            local part = h.Parent:FindFirstChild("HumanoidRootPart") or h.Parent:FindFirstChildWhichIsA("BasePart")
            if part then list[#list + 1] = part end
        end
    end
    return list
end

local function boost(tool)
    if not (S.dmg and hasTouch and root) then return end
    local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
    if not handle then return end
    local extra = math.max(0, S.dmgMult - 1)
    for _, part in ipairs(getEnemies()) do
        if root and (part.Position - root.Position).Magnitude <= S.reach then
            for i = 1, extra do
                pcall(firetouchinterest, handle, part, 0)
                pcall(firetouchinterest, handle, part, 1)
                if i % 20 == 0 then task.wait() end
            end
        end
    end
end

local hooked = setmetatable({}, {__mode = "k"})
local function hookTool(t)
    if not t:IsA("Tool") or hooked[t] then return end
    hooked[t] = true
    connect(t.Activated, function() task.spawn(boost, t) end)
end

-- =====================================================================
-- Terapkan ulang fitur setelah respawn
-- =====================================================================
local function bindChar(c)
    char = c
    hum = c:WaitForChild("Humanoid", 10)
    root = c:WaitForChild("HumanoidRootPart", 10)
    if not hum or not root then return end
    DEFAULT_WALK = 16
    lastSafe = root.CFrame
    noclipTouched = {}
    for _, o in ipairs(c:GetChildren()) do hookTool(o) end
    connect(c.ChildAdded, hookTool)
    local bp = lp:FindFirstChildOfClass("Backpack")
    if bp then
        for _, o in ipairs(bp:GetChildren()) do hookTool(o) end
        connect(bp.ChildAdded, hookTool)
    end
    if S.god then godOn() end
    if S.fly then flyOn() end
end
if lp.Character then task.spawn(bindChar, lp.Character) end
connect(lp.CharacterAdded, function(c) task.spawn(bindChar, c) end)

-- =====================================================================
-- LOOP UTAMA
-- =====================================================================
connect(RunService.Heartbeat, function()
    if not (char and hum and root and root.Parent) then return end
    cam = workspace.CurrentCamera

    if S.god then
        if hum.MaxHealth ~= math.huge then pcall(function() hum.MaxHealth = math.huge end) end
        if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
        if hum:GetState() == Enum.HumanoidStateType.Dead then
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        if not char:FindFirstChild("BC_FF") then
            local ff = Instance.new("ForceField")
            ff.Name = "BC_FF"; ff.Visible = false; ff.Parent = char
        end
        local voidY = workspace.FallenPartsDestroyHeight + 60
        if root.Position.Y > voidY and hum.FloorMaterial ~= Enum.Material.Air then
            lastSafe = root.CFrame
        elseif root.Position.Y <= voidY and lastSafe then
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = lastSafe + Vector3.new(0, 5, 0)
        end
    end

    if S.fly then
        if not (flyBV and flyBV.Parent) then flyOn() end
        if flyBV then
            local md = hum.MoveDirection
            local cf = cam.CFrame
            local flatLook = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
            flatLook = flatLook.Magnitude > 0 and flatLook.Unit or Vector3.new(0, 0, -1)
            local flatRight = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z).Unit
            local f, r = md:Dot(flatLook), md:Dot(flatRight)
            local dir = cf.LookVector * f + cf.RightVector * r
            local up = 0
            if upHeld or UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.E) then up += 1 end
            if downHeld or UIS:IsKeyDown(Enum.KeyCode.Q) then up -= 1 end
            dir += Vector3.new(0, up, 0)
            flyBV.Velocity = dir * S.flySpeed
            flyBG.CFrame = cf
        end
    end

    if S.sprint and not S.fly then hum.WalkSpeed = S.runSpeed end
end)

connect(RunService.Stepped, function()
    if S.noclip and char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then
                noclipTouched[p] = true
                p.CanCollide = false
            end
        end
    end
end)

connect(UIS.JumpRequest, function()
    if S.inf and hum and hum.Parent and not S.fly then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)


-- GUI (tema Royal Gold)
-- =====================================================================
local C = {
    bg = Color3.fromRGB(14, 12, 17), panel = Color3.fromRGB(22, 19, 26), input = Color3.fromRGB(34, 29, 38),
    stroke = Color3.fromRGB(110, 86, 40), accent = Color3.fromRGB(236, 186, 74),
    text = Color3.fromRGB(248, 242, 230), sub = Color3.fromRGB(176, 164, 142),
    green = Color3.fromRGB(90, 228, 150), ink = Color3.fromRGB(28, 18, 4),
}
local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    o.Parent = parent
    return o
end
local function round(o, r) new("UICorner", {CornerRadius = UDim.new(0, r or 8)}, o) end

local gui = new("ScreenGui", {Name = "BC_PlayMode", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 999}, nil)

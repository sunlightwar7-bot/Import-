-- Cleanup kalau script dijalankan lagi
if getgenv then
    getgenv().BC_PLAYMODE_CLEANUP = function()
        S.god, S.fly, S.noclip, S.sprint, S.inf = false, false, false, false, false
        pcall(godOff); pcall(flyOff); pcall(noclipOff)
        if hum then pcall(function() hum.WalkSpeed = DEFAULT_WALK end) end
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        pcall(function() gui:Destroy() end)
    end
end

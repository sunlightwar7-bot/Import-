local C = {
    bg = Color3.fromRGB(14, 12, 17), panel = Color3.fromRGB(22, 19, 26), input = Color3.fromRGB(34, 29, 38),
    stroke = Color3.fromRGB(110, 86, 40), accent = Color3.fromRGB(236, 186, 74),
    accent2 = Color3.fromRGB(255, 232, 170), text = Color3.fromRGB(248, 242, 230),
    sub = Color3.fromRGB(176, 164, 142), ink = Color3.fromRGB(28, 18, 4), off = Color3.fromRGB(64, 55, 70),
    red = Color3.fromRGB(238, 82, 92),
}
local FONT = Enum.Font.GothamBold
local DEPTH = 4

local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    o.Parent = parent
    return o
end
local function round(o, r) new("UICorner", {CornerRadius = UDim.new(0, r or 8)}, o) end
local function shade(c, f) return Color3.new(math.min(1, c.R * f), math.min(1, c.G * f), math.min(1, c.B * f)) end

-- teks 3D: 2 lapis bayangan di belakang teks utama (efek timbul)
local function text3d(parent, p)
    local holder = new("Frame", {
        Size = p.Size or UDim2.fromScale(1, 1), Position = p.Position or UDim2.new(),
        BackgroundTransparency = 1, ZIndex = p.Z or 3,
    }, parent)
    local function lbl(off, col, z)
        return new("TextLabel", {
            Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(off, off), BackgroundTransparency = 1,
            Text = p.Text or "", TextColor3 = col, Font = FONT, TextSize = p.TextSize or 11,
            TextXAlignment = p.XAlign or Enum.TextXAlignment.Left, ZIndex = z,
        }, holder)
    end
    local s2 = lbl(2, Color3.fromRGB(8, 5, 0), (p.Z or 3))
    local s1 = lbl(1, p.Shadow or shade(p.Color or C.text, 0.4), (p.Z or 3) + 1)
    local top = lbl(0, p.Color or C.text, (p.Z or 3) + 2)
    return {
        set = function(text, color, shadow)
            for _, l in ipairs({s2, s1, top}) do l.Text = text end
            top.TextColor3 = color
            s1.TextColor3 = shadow or shade(color, 0.4)
        end,
    }
end

-- tombol 3D: sisi bawah tebal + permukaan yang turun saat ditekan
local function btn3d(parent, p)
    local holder = new("Frame", {Size = p.Size, Position = p.Position, BackgroundTransparency = 1, ZIndex = 3}, parent)
    local depth = new("Frame", {
        Size = UDim2.new(1, 0, 1, -DEPTH), Position = UDim2.fromOffset(0, DEPTH),
        BackgroundColor3 = shade(p.Color, 0.5), BorderSizePixel = 0, ZIndex = 3,
    }, holder)
    round(depth, p.Radius or 8)
    local face = new("TextButton", {
        Size = UDim2.new(1, 0, 1, -DEPTH), BackgroundColor3 = p.Color, Text = "", AutoButtonColor = false,
        BorderSizePixel = 0, ZIndex = 4,
    }, holder)
    round(face, p.Radius or 8)
    local grad = new("UIGradient", {Rotation = 90}, face)
    local function setGrad(c)
        grad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, shade(c, 1.3)),
            ColorSequenceKeypoint.new(0.5, c),
            ColorSequenceKeypoint.new(1, shade(c, 0.82)),
        })
    end
    setGrad(p.Color)
    new("UIStroke", {Color = shade(p.Color, 0.55), Thickness = 1, Transparency = 0.2}, face)
    local label = text3d(face, {
        Text = p.Text, TextSize = p.TextSize or 11, Color = p.TextColor or C.ink,
        Shadow = p.Shadow, XAlign = Enum.TextXAlignment.Center, Z = 5,
    })
    local api = {face = face, label = label}
    function api.setColor(c)
        face.BackgroundColor3 = c
        depth.BackgroundColor3 = shade(c, 0.5)
        setGrad(c)
    end
    local function press(down)
        TweenService:Create(face, TweenInfo.new(0.06), {Position = UDim2.fromOffset(0, down and (DEPTH - 1) or 0)}):Play()
    end
    face.MouseButton1Down:Connect(function() press(true); if p.onDown then p.onDown() end end)
    face.MouseButton1Up:Connect(function() press(false); if p.onUp then p.onUp() end end)
    face.MouseLeave:Connect(function() press(false); if p.onUp then p.onUp() end end)
    face.MouseButton1Click:Connect(function() if p.onClick then p.onClick() end end)
    return api
end


-- BALEREOT | SERVER PLAY MODE
-- Taruh sebagai *Script* (bukan LocalScript) di ServerScriptService.
--  1) GOD MODE server: kebal dari damage, Health = 0, BreakJoints, dan Humanoid dihapus
--  2) DAMAGE BOOST server: semua damage yang diterima NPC dilipatkan, apa pun cara damage-nya

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local CONFIG = {
    GOD = true,
    GOD_USERS = {},        -- isi nama pemain, contoh {"NamaKamu"}. Kosong = semua pemain kebal
    DAMAGE_BOOST = true,
    DAMAGE_MULT = 20,       -- damage ke NPC jadi x5 (ubah sesukamu)
}

-- =====================================================================
-- GOD MODE
-- =====================================================================
local function isListed(player)
    return #CONFIG.GOD_USERS == 0 or table.find(CONFIG.GOD_USERS, player.Name) ~= nil
end

local function protect(player, char)
    local hum = char:WaitForChild("Humanoid", 10)
    local root = char:WaitForChild("HumanoidRootPart", 10)
    if not hum or not root then return end

    hum.BreakJointsOnDeath = false
    hum.RequiresNeck = false
    hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
    hum.MaxHealth = math.huge
    hum.Health = math.huge

    local ff = Instance.new("ForceField")
    ff.Visible = false
    ff.Parent = char

    hum.HealthChanged:Connect(function()
        if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
    end)

    -- Jaga-jaga kalau NPC memakai BreakJoints() / Humanoid:Destroy():
    -- karakter di-respawn di tempat yang sama.
    local alive = true
    local lastCF = root.CFrame
    local function respawnHere()
        if not alive then return end
        alive = false
        local cf = lastCF
        player:LoadCharacter()
        local nc = player.Character or player.CharacterAdded:Wait()
        local r = nc:WaitForChild("HumanoidRootPart", 10)
        if r then r.CFrame = cf end
    end
    hum.AncestryChanged:Connect(function(_, parent)
        if not parent then respawnHere() end
    end)
    char.DescendantRemoving:Connect(function(d)
        if alive and d:IsA("Motor6D") and char.Parent then respawnHere() end
    end)

    -- Simpan posisi aman + anti jatuh ke void
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not alive or not root.Parent then conn:Disconnect() return end
        local voidY = workspace.FallenPartsDestroyHeight + 60
        if root.Position.Y > voidY and hum.FloorMaterial ~= Enum.Material.Air then
            lastCF = root.CFrame
        elseif root.Position.Y <= voidY then
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = lastCF + Vector3.new(0, 5, 0)
        end
        if hum.MaxHealth ~= math.huge then hum.MaxHealth = math.huge end
        if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
    end)
end

local function setupPlayer(player)
    player.CharacterAdded:Connect(function(char)
        if CONFIG.GOD and isListed(player) then task.spawn(protect, player, char) end
    end)
    if player.Character and CONFIG.GOD and isListed(player) then
        task.spawn(protect, player, player.Character)
    end
end
Players.PlayerAdded:Connect(setupPlayer)
for _, p in ipairs(Players:GetPlayers()) do setupPlayer(p) end

-- =====================================================================
-- DAMAGE BOOST (semua Humanoid yang bukan pemain)
-- =====================================================================
local hooked = setmetatable({}, {__mode = "k"})

local function hookNPC(hum)
    if hooked[hum] then return end
    local model = hum.Parent
    if not model or Players:GetPlayerFromCharacter(model) then return end
    hooked[hum] = true

    local last = hum.Health
    local expected = nil
    hum.HealthChanged:Connect(function(h)
        if expected and math.abs(h - expected) < 1e-3 then
            expected = nil
            last = h
            return
        end
        if CONFIG.DAMAGE_BOOST and CONFIG.DAMAGE_MULT > 1 and h < last and h > 0 then
            local target = math.max(0, h - (last - h) * (CONFIG.DAMAGE_MULT - 1))
            expected = target
            last = target
            hum.Health = target
        else
            last = h
        end
    end)
end

for _, d in ipairs(workspace:GetDescendants()) do
    if d:IsA("Humanoid") then hookNPC(d) end
end
workspace.DescendantAdded:Connect(function(d)
    if d:IsA("Humanoid") then task.defer(hookNPC, d) end
end)
